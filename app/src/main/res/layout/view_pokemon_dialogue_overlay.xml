<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogueOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialogueBox"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/pokemon_dialogue_box_bg"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.8">

        <TextView
            android:id="@+id/dialogueText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/pokemon_emerald"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            android:shadowColor="@color/dialogueBoxTextShadow"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.1"
            android:textColor="@color/dialogueBoxText"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dialogueNextIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/pokemon_emerald"
            android:text="▼"
            android:textColor="@color/dialogueBoxText"
            android:textSize="16sp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/yesNoBox"
        android:layout_width="128dp"
        android:layout_height="72dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/pokemon_dialogue_box_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/dialogueBox"
        app:layout_constraintEnd_toEndOf="@id/dialogueBox">

        <TextView
            android:id="@+id/yesOption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fontFamily="@font/pokemon_emerald"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:shadowColor="@color/dialogueBoxTextShadow"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.1"
            android:text="@string/trainer_call_rematch_confirm"
            android:textColor="@color/dialogueBoxText"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/noOption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fontFamily="@font/pokemon_emerald"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:shadowColor="@color/dialogueBoxTextShadow"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0.1"
            android:text="@string/trainer_call_rematch_cancel"
            android:textColor="@color/dialogueBoxText"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/yesOption" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
