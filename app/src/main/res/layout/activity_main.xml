<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pgMenuBackground">

    <!-- Back layer: plain white, set via the root background above. -->

    <!-- Scrolling tiled dots layer, drawn above the white back layer. -->
    <com.logie.pgearhs.ui.ScrollingTiledBackgroundView
        android:id="@+id/menuBackgroundDots"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gear outline, left-aligned, above the dots. Uniformly (not stretch-)scaled so its
         height exactly matches 1080px, which both Thor displays share, so it fits flush
         against the top and bottom of the screen without distorting its aspect ratio. -->
    <ImageView
        android:id="@+id/gearOutline"
        android:layout_width="304px"
        android:layout_height="1080px"
        android:contentDescription="@null"
        android:src="@drawable/gearoutline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Header bar, drawn above the dots but underneath the header image and nav icon. -->
    <View
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pgBarGray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navIconDividerWhite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/navIconRightPaddingGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/headerLeftPaddingGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1" />

    <ImageView
        android:id="@+id/headerImage"
        android:layout_width="650px"
        android:layout_height="100px"
        android:layout_marginTop="15px"
        android:contentDescription="@string/app_name"
        android:src="@drawable/header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/headerLeftPaddingGuideline" />

    <com.logie.pgearhs.ui.SpriteAnimationView
        android:id="@+id/navIcon"
        android:layout_width="90px"
        android:layout_height="110px"
        android:layout_marginTop="5px"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navIconRightPaddingGuideline" />

    <!-- Divider stripes touching the nav icon's bottom pixel. -->
    <View
        android:id="@+id/navIconDividerWhite"
        android:layout_width="0dp"
        android:layout_height="10px"
        android:background="@color/pgBarWhite"
        app:layout_constraintTop_toBottomOf="@id/navIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/navIconDividerGray"
        android:layout_width="0dp"
        android:layout_height="15px"
        android:background="@color/pgBarGray"
        app:layout_constraintTop_toBottomOf="@id/navIconDividerWhite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/navIconDividerDarkGray"
        android:layout_width="0dp"
        android:layout_height="5px"
        android:background="@color/pgBarDarkGray"
        app:layout_constraintTop_toBottomOf="@id/navIconDividerGray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/helloText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello_johto"
        android:textColor="@color/pgOnMenuBackground"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/settings_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
