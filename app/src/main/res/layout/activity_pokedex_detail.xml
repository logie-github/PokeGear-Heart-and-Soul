<?xml version="1.0" encoding="utf-8"?>
<!-- Ports the "Sidebar" layout from the Pokédex Screen HTML prototype directly: a real
     responsive grid (not a fixed-pixel GBA canvas), so 4:3/16:9 landscape both just work with
     no scaling tricks. Real per-species data from pokemon_dex_data.json; card/tab-bar chrome
     uses colors sampled from the real decomp screenshots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pokedex_grid_bg">

    <!-- Tab bar: ◀ INFO AREA STATS EVO CRY SIZE ▶ - flush against the real top/left/right edges
         of the screen, full width, square corners, like the real chrome (no card margin/rounding).
         No scroll view: each tab is sized in Kotlin to its real proportional share of the real
         240px-wide bar, so the whole row - including the trailing ▶ baked into the SIZE crop -
         always exactly fits the screen width instead of overflowing off the edge. -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/pokedexRedDeep" />

    <FrameLayout
        android:layout_width="match_parent"
        android:paddingHorizontal="10dp"
        android:paddingBottom="10dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <!-- ===================== INFO: sprite | id/vitals, description below =====================
             infoTabContent is a FrameLayout (not a weighted vertical stack) so the description
             card is pinned to a fixed position near the bottom of the screen, independent of
             however tall the top row ends up being - changes above no longer shift it. -->
        <FrameLayout
            android:id="@+id/infoTabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/detailTopRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="horizontal">

                <!-- sprite region: sized in code to its bare minimum (sprite + end padding) once
                     the id column needs the extra room - see widenIdColumn() -->
                <FrameLayout
                    android:id="@+id/detailLeftArea"
                    android:layout_width="wrap_content"
                    android:layout_weight="0.2925"
                    android:layout_height="match_parent"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/detailSprite"
                        android:layout_width="144dp"
                        android:layout_height="144dp"
                        android:layout_gravity="top|start"
                        android:contentDescription="@null" />
                </FrameLayout>

                <!-- id / footprint cards: width set in code to exactly 1.25x its previous real
                     measured width - see widenIdColumn() -->
                <LinearLayout
                    android:id="@+id/detailIdColumn"
                    android:layout_width="0dp"
                    android:layout_weight="1.76875"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/detailIdCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/pokedex_card_bg"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/detailIdHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/pokedex_card_header_bg"
                            android:padding="8dp"
                            android:gravity="start"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/detailCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:gravity="start"
                            android:textColor="@color/pokedexInkDim"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <!-- footprint box: same square size as before, still directly under and
                         left-aligned with the name box, with a top accent stripe the same
                         thickness as the name box's side accent -->
                    <FrameLayout
                        android:id="@+id/detailFootprintBox"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="start"
                        android:background="@drawable/pokedex_card_bg">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_gravity="top"
                            android:background="@drawable/pokedex_accent_top" />

                        <ImageView
                            android:id="@+id/detailFootprint"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- bottom stack: vitals card sits directly above the description card, both pinned
                 near the bottom of the screen as one unit, independent of the id/footprint
                 column above. Its width is set in code to exactly 3/4 of the name box's real
                 measured width (a static weight ratio can't do this exactly, since the sprite
                 region's weight also carries a fixed 152dp intrinsic offset the vitals row
                 doesn't share) - right-aligned via gravity="end" on this row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <!-- type chips: left-aligned, above the vitals card -->
                <LinearLayout
                    android:id="@+id/detailTypeChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="start"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:id="@+id/detailVitalsCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/pokedex_card_bg">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/pokedex_accent_left" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:text="@string/pokedex_ht_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:gravity="start"
                                    android:textColor="@color/pokedexInk"
                                    android:textSize="28sp" />

                                <TextView
                                    android:id="@+id/detailHeightValue"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:gravity="end"
                                    android:textColor="@color/pokedexInk"
                                    android:textSize="28sp" />
                            </LinearLayout>

                            <!-- dotted divider between HT and WT, dot size matches the row's own
                                 font size rather than a thin drawn line. Its exact dot count is
                                 computed in code (fitDottedDivider()) so it ends on a full dot
                                 instead of clipping one mid-glyph. -->
                            <TextView
                                android:id="@+id/detailDottedDivider"
                                android:text="@string/pokedex_dotted_divider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-6dp"
                                android:singleLine="true"
                                android:includeFontPadding="false"
                                android:textColor="@color/pokedexGridline"
                                android:textSize="28sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:text="@string/pokedex_wt_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:gravity="start"
                                    android:textColor="@color/pokedexInk"
                                    android:textSize="28sp" />

                                <TextView
                                    android:id="@+id/detailWeightValue"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:gravity="end"
                                    android:textColor="@color/pokedexInk"
                                    android:textSize="28sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- description card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/pokedex_card_bg"
                    android:padding="10dp">

                    <!-- includeFontPadding=false: the custom pixel font's own ascent/descent
                         leading was making the vertical whitespace visually bigger than the
                         10dp horizontal padding even though both were declared equal -->
                    <TextView
                        android:id="@+id/detailPokedexEntry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="3dp"
                        android:minLines="4"
                        android:maxLines="4"
                        android:ellipsize="end"
                        android:textColor="@color/pokedexInk"
                        android:textSize="28sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ===================== STATS ===================== -->
        <LinearLayout
            android:id="@+id/statsTabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pokedex_card_bg"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <com.logie.pgearhs.pokedex.IdleIconView
                    android:id="@+id/statsIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/statsName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/pokedexInk"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/statsTypeChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/pokedex_card_bg"
                android:padding="10dp">

                <GridLayout
                    android:id="@+id/statsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/pokedex_total_label"
                        android:textStyle="bold"
                        android:textColor="@color/pokedexInk" />

                    <TextView
                        android:id="@+id/statsTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/pokedexInk" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== AREA ===================== -->
        <LinearLayout
            android:id="@+id/areaTabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/areaMap"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/areaMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/pokedexInk"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===================== EVO ===================== -->
        <LinearLayout
            android:id="@+id/evoTabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pokedex_card_bg"
                android:padding="14dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/evoChainContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/evoEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/pokedexInkDim"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== CRY ===================== -->
        <LinearLayout
            android:id="@+id/cryTabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <com.logie.pgearhs.pokedex.CryScopeView
                android:id="@+id/cryScope"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="90dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pokedex_card_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/crySprite"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/cryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/pokedexInk"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="72dp"
                android:layout_marginStart="12dp">

                <ImageView
                    android:id="@+id/cryMeter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/cryNeedle"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===================== SIZE ===================== -->
        <LinearLayout
            android:id="@+id/sizeTabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/sizeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/pokedexInk"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/sizeFiguresRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <ImageView
                    android:id="@+id/sizePokemonImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />

                <Space
                    android:layout_width="24dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/sizeTrainerImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:background="#000000"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/sizeCaption"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/pokedexInkDim"
                android:textSize="11sp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
