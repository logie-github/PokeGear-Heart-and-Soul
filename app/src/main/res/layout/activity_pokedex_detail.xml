<?xml version="1.0" encoding="utf-8"?>
<!-- The whole screen is built in Kotlin at exact native 240x160 GBA coordinates inside
     GbaScreenLayout (see PokedexDetailActivity) - this file just letterboxes it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.logie.pgearhs.pokedex.GbaScreenLayout
        android:id="@+id/gbaScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
</FrameLayout>
