<?xml version="1.0" encoding="utf-8"?>
<!-- Real dashed/dotted divider line, drawn (not text-based) so it doesn't carry the pixel
     font's line-height/leading and stays thin regardless of font size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="3dp"
        android:color="@color/pokedexGridline"
        android:dashWidth="5dp"
        android:dashGap="4dp" />
</shape>
