<?xml version="1.0" encoding="utf-8"?>
<!-- Solid dark border, a thin inset light-gray ring, white fill - the classic Gen3 textbox. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialogueBoxBorder" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:top="5dp"
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dialogueBoxInsetRing" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dialogueBoxFill" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
