<?xml version="1.0" encoding="utf-8"?>
<!-- Red header band with a pink divider peeking out along the bottom edge,
     matching the real HGSS card chrome (sampled #E93131 / #F999A1). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pokedexPink" />
            <corners android:topLeftRadius="7dp" android:topRightRadius="7dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pokedexRed" />
            <corners android:topLeftRadius="7dp" android:topRightRadius="7dp" />
        </shape>
    </item>
</layer-list>
